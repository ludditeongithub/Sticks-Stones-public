{# MTODO: specializations for more than items #}
enum class {{ Specialization }} {
{% for item in items %}
  {{ item.name }},
{% endfor %}
  MAX
};

{% for f in fields %}
inline constexpr LookupTable<{{ Specialization }}, {{ f.type }}> {{ f.name }}s = [] {
LookupTable<{{ Specialization }}, {{ f.type }}> lt{};
  using enum {{ Specialization }};
{% for item in items %}
{% if f.name in item %}
lt[{{ item.name }}] = {{ item[f.name] }};
{% endif %}
{% endfor %}
return lt;
}();
{% endfor %}

struct {{ Specialization }}Database {
Database& database;
size_t size = 0;
std::stack<size_t> free_slots;
Array<size_t> indices;
{% for f in fields %}
  Array<{{f.type}}> {{f.name}}s;
{% endfor %}

// =========================
// INIT
// =========================

void init(Arena* arena, size_t capacity)
{
{% for f in fields %}
  {{ f.name }}s = arena_make_array<{{  f.type }}>(arena, capacity);
{% endfor %}
}

// =========================
// GETTERS
// =========================

{% for f in fields %}
  inline {{ f.type }}& {{ f.name }}(size_t index) {
return {{ f.name }}s[index];
  }
{% endfor %}

// =========================
// SPAWN
// =========================

void spawn_{{ specialization }}_component({{ Specialization }} {{ specialization }}, {% for f in fields %}
, {{ f.type }} {{ f.name}}
{% endfor %}
)
{
Item item = item_to_{{ specialization }}({{ specialization }});
size_t i;
if (free_slots.empty()) {
//TODO: emergency storage
i = size++;
} else i = free_slots.pop();
{% for f in fields %}
  {{ f.name }}(i) = {{ f.name }};
{% endfor %}
}

// =========================
// REMOVE
// =========================

inline bool remove(size_t i) {
free_slots.push(i);
database.remove(i);
}

// =========================
// SERIALIZATION
// =========================

    template <class Archive>
    void serialize(Archive &archive) const
    {
      archive(size);
      archive(free_slots);
      archive(indices);
      {% for f in fields %}
        archive({{ f.name }}s);
      {% endfor %}     
    }


// =========================
// TRANSFER
// =========================

inline bool transfer(size_t i, {{ Specialization }}Database &old_db)
{
  return database.transfer_item(i, old_db);
}

// =========================
// INVENTORY MANAGEMENT
// =========================

inline void pick_up(EntityID {{ specialization }}ID, Inventory& inventory) {
{{ Specialization }}Entity {{ specialization }} = get_entity(index);
Item item = reflect_enum({{ specialization }}.specialization);
inventory.add_item(item);
remove_{{ specialization }}({{ specialization }}ID);
}

inline void drop(EntityID {{ specialization }}ID, Inventory& inventory) {
add_entity();
}
