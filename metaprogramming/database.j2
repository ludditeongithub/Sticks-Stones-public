bool attempt_spawn(const {{ main_enum }} {{ entity_name }}, const Coord coord, const bool newborn {% if 'variant' in traits %} , const Variant variant {% endif %} {% if 'skin_color' in traits %}
, float parent1, float parent2
{% endif %}
{% if 'searchable' in traits %}
