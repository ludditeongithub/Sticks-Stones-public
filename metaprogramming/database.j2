{% endif %}
, const bool insert_search = true) {
Coord spawn_point = tiles->get_nearest_empty_tile(origin);
bool result = false;
result = attempt_spawn({{ entity_name }}, spawn_point, newborn
{% if 'variant' in traits %}
  , variant
{% endif %}
{% if 'skin_color' in traits %}
, parent1, parent2
{% endif %}
{% if 'searchable' in traits %}
, insert_search  
{% endif %}
);
if (!result) {
free_unused_entity();
attempt_spawn({{ entity_name }}, spawn_point, newborn
{% if 'variant' in traits %}
  , variant
{% endif %}
{% if 'skin_color' in traits %}
, parent1, parent2
{% endif %}
{% if 'searchable' in traits %}
, insert_search  
{% endif %});
}
return result;
}        
