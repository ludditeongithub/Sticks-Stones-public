{% endif %}
)
{
#if !SHIPPING_BUILD
assert({{ entity_name }} != {{ PascalCase(entity_name) }}::NONE && {{ entity_name }} != {{ PascalCase(entity_name) }}::MAX && "Tried to spawn {{ entity_name }} as NONE or MAX.");
#endif


        if (size + 1 > capacity)
            return 0;
        size_t i;
        if (free_slots.empty())
        {
            i = size;
            size++;
        }
        else
        {
            i = free_slots.top();
            free_slots.pop();
        }
        alives[i] = true;
        if (newborn)
        {
      {% for r in runtime_arrays %}
            this->{{ r.name }}(i) = {{ r.newborn_default }};
	  {% endfor %}
        }
        else
        {
        Time age = random_bool->next();
	  {% for r in runtime_arrays %}
            this->{{ r.name }}(i) = {{ r.random_age_default }};
	  {% endfor %}
        }
	  {% if 'searchable' in traits %}
            if (insert_search) search.insert_entity({{ entity_name }}, {i, this->coord(i)});
          {% endif %}
        return i;
          }
          
