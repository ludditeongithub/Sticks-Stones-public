{% if not 'immortal' in traits %}
  
  // =========================
  // REMOVE
  // =========================
  
  inline bool remove(const EntityID i)
  {
        if (!alives[i])
            return false;

        free_slots.push(i);
        alives[i] = false;
  {% if 'searchable' in traits %}
        {{ main_enum }} {{ entity_name}} = this->{{ entity_name }}(i);
            search.remove_entity({{ entity_name }}, {i, coord(i)});
  {% endif %}
        return true;
  }

  {# OPTI: operation if EVERY tile has been discovered#}
  inline void free_unused_entity()
  {
  {% if 'positional' in traits %}
    for (size_t i = 0; i < coords.capacity; i++) {
    if (tiles->tile_status(i).get<VisionStatus>() == VisionStatus::Hidden) remove(i);
    }
  {% endif %}
  }
{% endif %}    

{% if 'movable' in traits %}
  // =========================
  // MOVE
  // =========================
  
    inline bool attempt_move_entity(const EntityID index)
  {
  assert(index <= size);

        Coord& pos = coord(index);
        Coord new_pos = coord::move(pos, frame_data(index).get<Direction>());
        size_t ti = g_world->get_tile_index_from_coord(new_pos);

    if (tiles->tile_statuss[ti].get<OccupiedStatus>() == OccupiedStatus::Vacant)
        {
            pos = new_pos;
            return true;
        }

        return false;
    }
  {% endif %}

{% if 'transferable' in traits %}

// =========================
// TRANSFER
// =========================

inline bool transfer(size_t i, {{ entity_name }}::Database &old_db)
  {
  assert(i < size);
  
  if (size >= capacity) return false;
  int index;  
  if (free_slots.empty())
  {
  index = ++size;
	}
	else
	{
		index = free_slots.top();
		free_slots.pop();			
  }
   {% for r in runtime_arrays %}
    {{r.name}}(index) = old_db.{{r.name}}(i);
  {% endfor %}
  alives[index] = true;

  old_db.free_slots.push(i);
  old_db.alives[index] = false;
  return true;
  }
  
{% endif %}
