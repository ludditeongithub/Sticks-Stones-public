def replace_block(old_file, marker, new_content):
    pattern = rf"// @codegen:begin {marker}.*// @codegen:end {marker}"
    replacement = f"// @codegen:begin {marker}\n{new_content}\n    // @codegen:end {marker}"
    return re.sub(pattern, replacement, old_file, flags=re.S)

