#include <SDL2/SDL.h>
#include <stdexcept>
#include <fmt/format.h>
#include <iostream>
#include <memory>

void initialize_sdl();
void close_sdl();

class Window
{
public:
    Window();

    void init();
    void run();

    static int width;
    static int height;
private:
    const std::string title;
  std::unique_ptr<SDL_Window, decltype(&SDL_DestroyWindow)> window;
};

Window::Window() : title{"Open Window"}, window{nullptr, SDL_DestroyWindow} {}

void Window::init() {
  this->window.reset(SDL_CreateWindow(this->title.c_str(), SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, this->width, this->height, 0));
  if (!this->window) {
    auto error = fmt::format("Error Creating Window: {}", SDL_GetError());
    throw std::runtime_error(error);
  }
}

void initialize_sdl() {
  if (SDL_Init(SDL_INIT_EVERYTHING)) {
    auto error = fmt::format("Error initialize SDL_2: {}", SDL_GetError());
    throw std::runtime_error(error);
  }
}

void close_sdl() {
  SDL_Quit();
}

int main() {
  int exit_val = EXIT_SUCCESS;

  try {
    initialize_sdl();
  } catch (const std::runtime_error &e) {
    std::cerr << e.what() << std::endl;
    exit_val = EXIT_FAILURE;
  }

  close_sdl();
  
  return exit_val;
}
