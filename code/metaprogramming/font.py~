import yaml

def create_fonts():
    with open("font.yaml", "r") as f:
        config = yaml.safe_load(f)

        relative_path = f"../ui/fonts.hpp"

        for _, entity in config["fonts"].items():            
            generated_code = create_font(entity["name"])
            
            meta.replace_block(
                relative_path,
                "fonts",
                generated_code
            )

def create_font(font):
    context = {
        "name" : font,
        "ttf" : font.ttf,
        "color" : font.color
    }
    template = meta.env.get_template("fonts.j2")
    return template.render(**context)
