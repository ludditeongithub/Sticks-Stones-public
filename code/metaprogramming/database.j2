  bool attemptSpawn({{ Main_enum }} {{ entity_name }}, bool newborn, Coord coord, {% if 'variant' in traits %} Variant variant {% endif %})
  {       
        if (size + 1 > capacity)
            return false;
        size_t i;
        if (freeSlots.empty())
        {
            i = size;
            size++;
        }
        else
        {
            i = freeSlots.top();
            freeSlots.pop();
        }
        alives[i] = true;
        if (newborn)
        {
      {% for r in runtime_arrays %}
            {{ r.name }}[i] = {{ r.newborn_default }};
	  {% endfor %}
        }
        else
        {
        Time age = random_bool->next();
	  {% for r in runtime_arrays %}
            {{ r.name }}[i] = {{ r.random_age_default }};
	  {% endfor %}
        }
	  {% if 'searchable' in traits %}
            search.insertEntity({{ entity_name }}, {i, coords[i]});
          {% endif %}
        return true;
          }
{# TODO: error report if it does NOT spawn on passed origin #}
          bool spawn({{ Main_enum }} {{ entity_name }}, bool newborn, Coord origin) {
          Coord spawnPoint = tiles.getNearestEmptyTile(origin);
          while (!attemptSpawn({{ entity_name }}, newborn, spawnPoint)) freeUnusedEntity();                 
          }        
