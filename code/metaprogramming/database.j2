inline bool transfer{{ Entity_name }}(size_t i, {{ Entity_name }}Database &oldDB, {{ Entity_name }}Database &newDB)
  {
  if (newDB.size >= newDB.capacity) return false;
  int index;  
  if (newDB.freeSlots.empty())
  {
  index = ++size;
	}
	else
	{
		index = newDB.freeSlots.top();
		newDB.freeSlots.pop();			
  }
   {% for r in runtime_arrays %}
    newDB.{{r.name}}[index] = oldDB.{{r.name}}[i];
  {% endfor %}
  newDB.alives[index] = true;
  oldDB.freeSlots.push(i);
  oldDB.alives[index] = false;
  return true;
  }
{% endif %}

