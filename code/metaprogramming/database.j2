  // =========================
  // SPAWN
  // =========================

{% if 'generated' in traits %}
  void add_{{ entity_name }}s(WorldSpawner::{{ Entity_name }}SpawnBuffer& spawn_buffer)
{
	for (size_t i = 0; i < spawn_buffer.size; i++)
	  if (spawn(spawn_buffer.{{ entity_name }}(i), spawn_buffer.coord(i), false)) {}
	  else
	    {
	      //TODO: error
	    }
}
{% endif %}
 
  bool attempt_spawn({{ main_enum }} {{ entity_name }}, bool newborn, Coord coord {% if 'variant' in traits %} , Variant variant {% endif %} {% if 'searchable' in traits %}
, bool insert_search = true
{% endif %}
)
  {       
        if (size + 1 > capacity)
            return false;
        size_t i;
        if (free_slots.empty())
        {
            i = size;
            size++;
        }
        else
        {
            i = free_slots.top();
            free_slots.pop();
        }
        alives[i] = true;
        if (newborn)
        {
      {% for r in runtime_arrays %}
            {{ r.name }}(i) = {{ r.newborn_default }};
	  {% endfor %}
        }
        else
        {
        Time age = random_bool->next();
	  {% for r in runtime_arrays %}
            {{ r.name }}(i) = {{ r.random_age_default }};
	  {% endfor %}
        }
	  {% if 'searchable' in traits %}
            if (insert_search) search.insert_entity({{ entity_name }}, {i, coord(i)});
          {% endif %}
        return true;
          }
          
{# TODO: error report if it does NOT spawn on passed origin #}
          bool spawn({{ main_enum }} {{ entity_name }}, bool newborn, Coord origin) {
          Coord spawn_point = tiles.get_nearest_empty_tile(origin);
          while (!attempt_spawn({{ entity_name }}, newborn, spawn_point)) free_unused_entity();                 
          }        
{% endif %}    

{% if not 'immortal' in traits %}
  // =========================
  // REMOVE
  // =========================
  
  bool remove(size_t i)
  {
        if (!alive(i))
            return false;

        free_slots.push(i);
        alive(i) = false;
  {% if 'searchable' in traits %}
        {{ main_enum }} {{ entity_name}} = {{ entity_name }}(i);
            search.remove_entity({{ entity_name }}, {i, coord(i)});
  {% endif %}
        return true;
  }

  {# OPTI: operation if EVERY tile has been discovered#}
  void free_unused_entity()
  {
  {% if 'positional' in traits %}
    for (size_t i = 0; i < coords.size; i++) {
    if (tiles.tile_status(i).get<VisionStatus>() == VisionStatus::Hidden) remove(i);
    }
  {% endif %}
  }
{% endif %}    

{% if 'movable' in traits %}
  // =========================
  // MOVE
  // =========================
  
    inline bool attempt_move_entity(size_t index)
    {
        Coord& pos = coord(index);
        Coord new_pos = get_pos(frame_data(index).get<Direction>(), pos);
        size_t ti = world.get_tile_index_from_coord(new_pos);

        if (search.tiles.tile_statuses.get<OccupiedStatus>()[ti] == false)
        {
            pos = new_pos;
            return true;
        }

        return false;
    }
  {% endif %}

