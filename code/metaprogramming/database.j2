  // =========================
  // REMOVE
  // =========================
  
  bool remove(size_t i)
  {
        if (!alives[i])
            return false;

        freeSlots.push(i);
        alives[i] = false;
  {% if 'searchable' in traits %}
        {{ Main_enum }} {{ entity_name}} = {{ entity_name }}s[i];
            search.removeEntity({{ entity_name }}, {i, coords[i]});
  {% endif %}
        return true;
  }

  {# OPTI: operation if EVERY tile has been discovered#}
  void freeUnusedEntity()
  {
  {% if 'positional' in traits %}
    for (size_t i = 0; i < coords.size; i++) {
    if (tiles.tileStatuses[i].get<VisionStatus>() == VisionStatus::Hidden) remove(i);
    }
  {% endif %}
  }
{% endif %}    

{% if 'movable' in traits %}
  // =========================
  // MOVE
  // =========================
  
    inline bool attemptMoveEntity(size_t index)
    {
        Coord& pos = coords[index];
        Coord newPos = getPos(frameDatas[index].get<Direction>(), pos);
        size_t ti = world.getTileIndexFromCoord(newPos);

        if (search.tiles.tileStatuses.get<OccupiedStatus>()[ti] == false)
        {
            pos = newPos;
            return true;
        }

        return false;
    }
    {% endif %}
      
