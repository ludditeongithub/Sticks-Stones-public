// =========================
// CONSTRUCTOR
// =========================

Database(Arena *arena, size_t capacity
{% if 'movable' or 'searchable' in traits %}
  , World& world
{% endif %} 
{% if 'searchable' in traits %}
  , SearchGrid& search
{% endif %}
{% if 'positional' in traits %}
  , tile::Database& tiles
{% endif %}
{% if 'variant_items' in database_references %}
  , item::VariantDatabase& variant_items
{% endif %}
) :
{% if 'movable' or 'searchable' in traits %}
  world(world),
{% endif %}
{% if 'positional' in traits %}
  tiles(tiles),
{% endif %}
{% if 'searchable' in traits %}
search(search),
{% endif %}
{
this->capacity = capacity;
{% if 'movable' in traits %}
  no_inertia_list.reserve(capacity);
{% endif %}

{% if not 'immortal' in traits %}
  this->size = 0;
{% endif %}
{% if 'variant_items' in database_references %}
  this->variant_items = variant_items;
{% endif %}
{% if entity_name == 'animal' %}
  fertilization_handler = EggFertilizationHandler(capacity / 20);  
{% endif %}

{% for s in structs %}
{% for f in s.fields %}
  {{ s.name }}.{{ f.name }} = arena_make_array<{{  f.type }}>(capacity);
  {% endfor %}
{% endfor %}

{% for r in runtime_arrays %}
 {{ r.name }} = arena_make_array<{{ r.type }}>(capacity);
{% endfor %}

}

