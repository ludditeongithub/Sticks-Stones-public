  bool attempt_spawn({{ Main_enum }} {{ entity_name }}, bool newborn, Coord coord, {% if 'variant' in traits %} Variant variant {% endif %})
  {       
        if (size + 1 > capacity)
            return false;
        size_t i;
        if (free_slots.empty())
        {
            i = size;
            size++;
        }
        else
        {
            i = free_slots.top();
            free_slots.pop();
        }
        alives[i] = true;
        if (newborn)
        {
      {% for r in runtime_arrays %}
            {{ r.name }}[i] = {{ r.newborn_default }};
	  {% endfor %}
        }
        else
        {
        Time age = random_bool->next();
	  {% for r in runtime_arrays %}
            {{ r.name }}[i] = {{ r.random_age_default }};
	  {% endfor %}
        }
	  {% if 'searchable' in traits %}
            search.insert_entity({{ entity_name }}, {i, coords[i]});
          {% endif %}
        return true;
          }
{# TODO: error report if it does NOT spawn on passed origin #}
          bool spawn({{ Main_enum }} {{ entity_name }}, bool newborn, Coord origin) {
          Coord spawn_point = tiles.get_nearest_empty_tile(origin);
          while (!attempt_spawn({{ entity_name }}, newborn, spawn_point)) free_unused_entity();                 
          }        
{% endif %}    

{% if not 'immortal' in traits %}
  // =========================
  // REMOVE
  // =========================
  
  bool remove(size_t i)
  {
        if (!alives[i])
            return false;

        free_slots.push(i);
        alives[i] = false;
  {% if 'searchable' in traits %}
        {{ Main_enum }} {{ entity_name}} = {{ entity_name }}s[i];
            search.remove_entity({{ entity_name }}, {i, coords[i]});
  {% endif %}
        return true;
  }

  {# OPTI: operation if EVERY tile has been discovered#}
  void free_unused_entity()
  {
  {% if 'positional' in traits %}
    for (size_t i = 0; i < coords.size; i++) {
    if (tiles.tile_statuses[i].get<VisionStatus>() == VisionStatus::Hidden) remove(i);
    }
  {% endif %}
  }
{% endif %}    

{% if 'movable' in traits %}
  // =========================
  // MOVE
  // =========================
  
    inline bool attempt_move_entity(size_t index)
    {
        Coord& pos = coords[index];
        Coord new_pos = get_pos(frame_datas[index].get<Direction>(), pos);
        size_t ti = world.get_tile_index_from_coord(new_pos);

        if (search.tiles.tile_statuses.get<OccupiedStatus>()[ti] == false)
        {
            pos = new_pos;
            return true;
        }

        return false;
    }
  {% endif %}

      // =========================
    // SERIALIZATION
    // =========================

    template <class Archive>
    void save(Archive &archive) const
    {
    archive(capacity);
{% if not 'immortal' in traits %}
        archive(size);
        archive(free_slots);
        archive(alives);
{% endif %}   

{% for r in runtime_arrays %}
        {{ r.name }}.save(archive);
{% endfor %}
    }

    template <class Archive>
    void load(Archive &archive)
    {
        archive(capacity);
{% if not 'immortal' in traits %}
        archive(size);
        archive(free_slots);
        archive(alives);
{% endif %}
        
{% for r in runtime_arrays %}
        {{ r.name }}.load(archive);
{% endfor %}
    }

{% if 'transferable' in traits %}

// =========================
// TRANSFER
// =========================

inline bool transfer{{ Entity_name }}(size_t i, {{ Entity_name }}Database &old_db, {{ Entity_name }}Database &new_db)
  {
  if (new_db.size >= new_db.capacity) return false;
  int index;  
  if (new_db.free_slots.empty())
  {
  index = ++size;
	}
	else
	{
		index = new_db.free_slots.top();
		new_db.free_slots.pop();			
  }
   {% for r in runtime_arrays %}
    new_db.{{r.name}}[index] = old_db.{{r.name}}[i];
  {% endfor %}
  new_db.alives[index] = true;
  old_db.free_slots.push(i);
  old_db.alives[index] = false;
  return true;
  }
{% endif %}
