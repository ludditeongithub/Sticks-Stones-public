{% if not 'immortal' in traits %}
  // =========================
  // SPAWN
  // =========================
  
  bool spawn({{ Entity_name }} entity, bool newborn, Coord coord)
    {
        if (size + 1 > capacity)
            return false;

        size_t i;

        if (freeSlots.empty())
        {
            i = size;
            size++;
        }
        else
        {
            i = freeSlots.top();
            freeSlots.pop();
        }

        alives[i] = true;

        if (newborn)
        {
      {% for r in runtime_arrays %}
            {{ r.name }}[i] = {{ r.newborn_default }};
	  {% endfor %}
        }
        else
        {
        Time age = random_bool->next();
	  {% for r in runtime_arrays %}
            {{ r.name }}[i] = {{ r.random_age_default }};
	  {% endfor %}
        }
	  {% if 'searchable' in traits %}
  
          {% endif %}

        return true;
    }
{% endif %}    

{% if not 'immortal' in traits %}
  // =========================
  // REMOVE
  // =========================
  
  bool remove(size_t i)
    {
        if (!alives[i])
            return false;

        freeSlots.push(i);
        alives[i] = false;

        search.deleteEntity();

        return true;
    }
{% endif %}    

{% if 'movable' in traits %}
  // =========================
  // MOVE
  // =========================
  
    inline bool attemptMoveEntity(size_t index)
    {
        Coord& pos = coords[index];
        Coord newPos = getPos(directions[index], pos);
        size_t ti = world.getTileIndexFromCoord(newPos);

        if (search.tiles.occupieds[ti] == false)
        {
            pos = newPos;
            return true;
        }

        return false;
    }
    {% endif %}
      
