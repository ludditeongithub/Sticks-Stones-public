    template <class Archive>
    void save(Archive &archive) const
    {
    archive(capacity);
{% if not 'immortal' in traits %}
        archive(size);
        archive(freeSlots);
        archive(alives);
{% endif %}   

{% for r in runtime_arrays %}
        {{ r.name }}.save(archive);
{% endfor %}
    }

    template <class Archive>
    void load(Archive &archive)
    {
        archive(capacity);
{% if not 'immortal' in traits %}
        archive(size);
        archive(freeSlots);
        archive(alives);
{% endif %}
        
{% for r in runtime_arrays %}
        {{ r.name }}.load(archive);
{% endfor %}
    }

