{% if 'transferable' in traits %}

// =========================
// TRANSFER
// =========================

inline bool transfer_{{ entity_name }}(size_t i, {{ entity_name }}::Database &old_db)
  {
  if (size >= capacity) return false;
  int index;  
  if (free_slots.empty())
  {
  index = ++size;
	}
	else
	{
		index = free_slots.top();
		free_slots.pop();			
  }
   {% for r in runtime_arrays %}
    {{r.name}}(index) = old_db.{{r.name}}(i);
  {% endfor %}
  alive(index) = true;
  old_db.free_slots.push(i);
  old_db.alive(index) = false;
  return true;
  }
{% endif %}
