void queueReadyActions(std::vector<EntityID>& buffer, Array<Time>& inertias)
{
		buffer.reserve(inertias.size);
		for (size_t i = 0; i < inertias.size; i++)
			if (inertias[i]-- <= 0)
					{
							buffer.emplace_back(i);							
					}
	buffer.shrink_to_fit();
}


// TODO: factor in hunger
// TODO: add to-do to go put away items to have necessary space for tools or
// items etc, when pawn goes to grab items
void processEntityActions(std::vector<EntityID> &buffer, std::optional<Array<Animal>> &animals, Array<Coord> &coords, Array<size_t>& targets, Array<Action>& actions, Array<FrameData>& frameDatas)
{
	// TODO: reverse order every tick, so interactions are balanced
	for (int j = 0; j < buffer.size(); j++)
			{
					EntityID i = buffer[j];
					switch (actions[i]) {
					case Action::Idle:
					case Action::Sleep:
       						continue;
       						break;
					case Action::Prowl:
					case Action::CheckProwl:
				
					case Action::Wander:
       			       		directions[i] = getRandomAdjDirection(directions[i]);
							moveInDirection(i, false);
							inertias[i] =
							    calcInertia(Action::Wander,
											minSpeedPawn, coords[i]);
       						break;
					case case-4:
       						
							break;
					default:
							
					}
			
		}
		else if (actions[i] == Action::Wander)
		{
		
		}
		else if (actions[i] == Action::Prowl ||
			 actions[i] == Action::CheckProwl)
		{ // TODO: ProwlTile
			if (rint(0, 50) < 50)
				directions[i] = getRandomAdjDirection(directions[i]);
			moveInDirection(i, false);
			// check surroundings, if target is now seen
			Object obj = currentTarget[i];
			if (actions[i] = Action::CheckProwl)
				ran = true;
			if (isItem(obj))
				itemCheck(pawn, directions[i], ran);
			else if (isPlant(obj))
				searchPlantCheck(pawn, directions[i], ran);
			else if (isScavengeable(obj))
				scavengeableCheck(pawn, directions[i], ran);
			// TODO:: Fruit
			// TODO:: animal
			else if (isTools(obj))
				toolCheck(pawn);
			inertias[i] = calcSpeed(midSpeedPawn, coords[i]);
		}
		else if (actions[i] == Action::ApproachPlant ||
			 actions[i] == Action::ApproachTile ||
			 actions[i] == Action::ApproachTool ||
			 actions[i] == Action::ApproachItem)
		{
			std::pair<Direction, bool> next = nextDirectionToTarget(i);
			direction[i] = next.first;
			if (next.second)
			{
				moveInDirection(i, false);
				inertias[i] = calcSpeed(minSpeedPawn, coords[i]);
			}
			else
			{
				if (actions[i] == Action::ApproachItem)
					takeItem(i, coords[i]);
				else if (actions[i] == Action::ApproachPlant)
					harvestPlant(i, coords[i]);
				else if (actions[i] == Action::ApproachTile)
					harvestTile(i, coords[i]);
				else if (actions[i] == Action::ApproachScavengeable)
					harvestScavengeable(i, coords[i]);
				else if (actions[i] == Action::ApproachTool)
					takeTool(i, coords[i]);
				actions[i] = Action::Idle;
				decideTask(i);
			}
		}
		else if (actions[i] == Action::GetTool ||
			 actions[i] == Action::GetItem)
		{
			std::pair<Direction, bool> next = nextDirectionToTarget(i);
			direction[i] = next.first;
			if (next.second)
			{
				moveInDirection(i, false);
				inertias[i] = calcSpeed(midSpeedPawn, coords[i]);
				// promised versions, while approach is non-promise
				if (actions[i] == Action::GetItem)
					takeItem(i, coords[i]);
				else
					takeTool(i, coords[i]);
				actions[i] = Action::Idle;
				findPromise.set();
			}
			else if (actions[i] == Action::Pursuit ||
				 actions[i] == Action::AnimalPursuit)
			{
				std::pair<Direction, bool> next = nextDirectionToMovingTarget(i);
				direction[i] = next.first;
				if (next.second)
					moveInDirection(i, false);
				else
				{
					if (actions[i] == Action::Pursuit)
					{
						// TODO: get new military target
						if (attack(i, currentDest[i], false, false))
							getNewTarget();
					}
					// TODO: do this
					if (actions[i] == Action::AnimalPursuit)
						if (attack(i, currentDest[i], false, true))
							dealWithGame();
				}
				inertias[i] = calcSpeed(maxSpeedPawn, coords[i]);
			}
		}
	}
}	

	void moveAnimals()
	{
		for (int i = 0; i < animalCoords.size(); i++)
		{
			if (animalAction[i] == Action::Idle ||
			    animalAction[i] == Action::Sleep)
				continue;
			else if (inertias[i] > 0)
			{
				inertias--;
				continue;
			}
			else if (animalAction[i] == Action::Wander)
			{
				// NOTE: makes it stop a lot
				if (rint(0, 3) < 3)
					continue;
				directions[i] = getRandomAdjDirection(directions[i]);
				moveInDirection(i, true);
				inertias[i] = calcInertia(minSpeed[animals[i]], coords[i]);
				if (animalHunger[i] < maxHungerThreshold[animals[i]])
					animalAction[i] = Action::CheckProwl;
			}
			else if (animalAction[i] == Action::Prowl ||
				 animalAction[i] == Action::CheckProwl)
			{ // TODO: ProwlTile
				if (rint(0, 50) < 50)
					directions[i] = getRandomAdjDirection(directions[i]);
				moveInDirection(i, directions[i], true);
				// check surroundings, if target is now seen
				Object obj = currentTarget[i];
				if (animalAction[i] = Action::CheckProwl)
					ran = true;
				switch (diets[animals[i]])
				{
				case Diet::Herbivore:
				case Diet::Omnivore:
					ediblePlantCheck(i, directions[i], ran);
					fruitCheck(i, directions[i], ran);
				case Diet::Herbivore:
					break;
				case Diet::Scavenger:
					corpseCheck(i, directions[i], ran);
				case Diet::Carnivore:
					huntCheck(i, directions[i], ran);
				}
				inertias[i] = calcSpeed(midSpeed[animals[i]], coords[i]);
				else if (animalAction[i] == Action::ApproachPlant ||
					 animalAction[i] == Action::ApproachTile ||
					 animalAction[i] == Action::ApproachGrass ||
					 animalAction[i] == Action::ApproachFruit)
				{
					std::pair<Direction, bool> next = nextDirectionToTarget(i);
					direction[i] = next.first;
					if (next.second)
					{
						moveInDirection(i, false);
						inertias[i] = calcSpeed(minSpeedPawn, coords[i]);
					}
					else
					{
						if (actions[i] == Action::ApproachPlant)
							eatPlant(i, coords[i]);
						else if (actions[i] ==
							 Action::ApproachFruit)
							eatFruit(i, coords[i]);
						else if (actions[i] ==
							 Action::ApproachGrass)
							eatGrass(i, coords[i]);
						else if (actions[i] ==
							 Action::ApproachTile)
							animalDecideMovement(i);
					}
				}
				else if (actions[i] == Action::AnimalPursuit)
				{
					std::pair<Direction, bool> next =
					    nextDirectionToMovingTarget(i);
					direction[i] = next.first;
					if (next.second)
						moveInDirection(i, true);
					else
					{
						// TODO: do this
						if (actions[i] == Action::AnimalPursuit)
							if (attack(i, currentDest[i], false, true))
								eatCorpse(i);
					}
					inertias[i] = calcSpeed(maxSpeedPawn, coords[i]);
				}
			}
		}

