// raw inertia value
inline Time TileDatabase::calcInertia(float entityBaseFrames, const Coord coord)
{
	return static_cast<int>(entityBaseFrames * tileFrameMultiplier[tiles[getIndex(coord)]]);
}

template <typename DB>
inline void moveEvent(DB& database, TileDatabase& tiles, EntityID i, const Direction direction)
{
  Coord& coord = database.coords[i];
  coord.move(direction);
  if (typeid(database) == AnimalDatabase)
  {
    Animal animal = database.animals[i];
    database.inertias[i] = tiles.calcInertia(animal::walkingFramePerTiles[animal], coord);
  }
  else
	  database.inertias[i] = tiles.calcInertia(coord);
  // TODO: speed for different units
}

