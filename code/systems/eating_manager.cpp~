inline Time eatingTimer(Hunger eatingAmount, Animal eater) {
  return eatingAmount / (eatingSpeeds[eater] / HOUR_LENGTH);
}

inline bool EatingManager::eatCorpse(
    Array<Animal> &animals, Array<Hunger> &hungers, Array<Coord> &animalCoords,
    Array<Time> &timers, size_t animalIndex, Array<Hunger> &corpseHungers,
    Array<Time> &corpseTimes, Array<Coord> &corpseCoords, size_t corpseIndex) {
  Animal a = animals[animalIndex];
  if (corpseTimes[corpseIndex] > CORPSE_ROT_TIME || !adjacentTiles(corpseCoords[corpseIndex], animalCoords[animalIndex])) {
    return false;
  } else {
    Hunger& ch = corpseHungers[corpseIndex];
    Hunger& h = hungers[animalIndex];
    if (maxHungers[animals[animalIndex]] > ch + h) {
        timers[animalIndex] = eatingTimer(ch, a);
	h += ch;
	ch = 0;
      } else {
	Hunger hd = maxHungers[a] - h;
	ch -= hd;
	h += hd;
	timers[animalIndex] = eatingTimer(hd, a);
      }        
   }  
  return true;
}

//lacks verification if animal can eat current plant
inline bool
EatingManager::eatPlant(Array<Animal> &animals, Array<Hunger> &hungers,
                            Array<Time> &timers, Array<Coord> &animalCoords,
                         size_t animalIndex, 
                         Array<Health> &plantHealths, Array<Coord> &plantCoords,
                         size_t plantIndex) {
  if (adjacentCoords(plantCoords[plantIndex], animalCoords[animalIndex]))
    return false;
  Animal a = animals[animalIndex];
  Health& h = plantHealths[plantIndex];
  Hunger mh = maxHungers[a];
  Hunger& hv = hungers[animalIndex];
  if (mh < hv + static_cast<Hunger>(h)) {
    Hunger rh = mh - hv;
    h -= static_cast<Health>(rh);
    hv = mh;
    timers[animalIndex] = eatingTimer(rh, a);
  } else {
    Hunger ah = h;
    h = 0;
    hv += ah;
    timers[animalIndex] = eatingTimer(ah, a);
  }
  return true;
}

// TODO: events like these, what happesn to the grass tile is
inline bool EatingManager::eatGrass(Array<Animal> &animals,
                                    Array<Hunger> &hungers,
                                    Array<Coord> &coords, Array<Time> &timers,
                                    size_t animalIndex,
                                    Array<TileData> &tiles) {
  size_t ti = coordToIndex(coords[animalIndex], TILES_AMOUNT);
  TileData& tile = tiles[ti];
  if (tileGrass(tile)) {
    Hunger mh = maxHungers[animals[animalIndex]];
    Hunger& hv = hungers[animalIndex];
    hv = min(mh, hv + GRASS_HUNGER_VALUE);    
    degrassTile(tile);
    timers[animalIndex] = GRASS_EATING_TIME;
    actions[animalIndex] = ActionStatus::PerformAction;
    return true;
  }
  return false;
}

