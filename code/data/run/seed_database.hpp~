#pragma once
#include <core/containers.hpp>
#include "../plant/enum.hpp"
#include "macros/database.hpp"
#include <data/types/aliases.hpp>
namespace seed {
struct Database {
	// @codegen:begin database_generation
// =========================
// BASE DATABASE MEMBERS
// =========================

constexpr static uint16_t entity_size = sizeof(Plant) +
+ sizeof(bool)
  
 +  sizeof(Plant) 
 +  sizeof(Coord) 
 +  sizeof(Time) 
;

size_t capacity;
    size_t size = 1; // 0 is placeholder
    Stack<size_t> free_slots;
    Array<bool> alives;
  World& world;
  tile::Database& tiles;

    // =========================
    // ENTITY-SPECIFIC MEMBERS
    // =========================
    Array<Plant> plants;
    Array<Coord> coords;
    Array<Time> ages;



// =========================
// CONSTRUCTOR
// =========================

Database(Arena& arena, size_t capacity
  , World& world
 
  , tile::Database& tiles
) :
  world(world),
  tiles(tiles),
{
this->capacity = capacity;

  this->size = 0;


 
 plants = arena_make_array<Plant>(arena, capacity); 
 
 coords = arena_make_array<Coord>(arena, capacity); 
 
 ages = arena_make_array<Time>(arena, capacity); 
 

}

// =========================
// GETTERS
// =========================

  inline Plant& plant(const EntityID index) {
return plants[index];
  }
  inline Coord& coord(const EntityID index) {
return coords[index];
  }
  inline Time& age(const EntityID index) {
return ages[index];
  }


  
  // =========================
  // SPAWN
  // =========================


bool attempt_spawn(const Plant plant, const bool newborn, const Coord coord  )
{
#if !SHIPPING_BUILD
assert(plant != Plant::NONE && plant != Plant::MAX && "Tried to spawn plant as NONE or MAX.");
#endif


        if (size + 1 > capacity)
            return 0;
        size_t i;
        if (free_slots.empty())
        {
            i = size;
            size++;
        }
        else
        {
            i = free_slots.top();
            free_slots.pop();
        }
        alives[i] = true;
        if (newborn)
        {
            this->plant(i) = plant;
            this->coord(i) = coord;
            this->age(i) = 0;
        }
        else
        {
        Time age = random_bool->next();
            this->plant(i) = plant;
            this->coord(i) = coord;
            this->age(i) = age;
        }
        return i;
          }
          
        

size_t spawn(const Plant plant, const bool newborn, const Coord origin
, const bool insert_search = true) {
Coord spawn_point = tiles.get_nearest_empty_tile(origin);
size_t result = 0;
while (result == 0) {
result = attempt_spawn(plant, newborn, spawn_point
);
if (result == 0) free_unused_entity();
}
}        
    

  // =========================
  // REMOVE
  // =========================
  
  inline bool remove(const EntityID i)
  {
        if (!alives[i])
            return false;

        free_slots.push(i);
        alives[i] = false;
        return true;
  }

  inline void free_unused_entity()
  {
    for (size_t i = 0; i < coords.size; i++) {
    if (tiles.tile_status(i).get<VisionStatus>() == VisionStatus::Hidden) remove(i);
    }
  }
    


    // =========================
    // SERIALIZATION
    // =========================

  // genreal serialization

    template <class Archive>
    void save(Archive &archive) const
    {
    archive(capacity);
        archive(size);
        archive(free_slots);
        archive(alives);
   

        plants.save(archive);
        coords.save(archive);
        ages.save(archive);
    }

    template <class Archive>
    void load(Archive &archive)
    {
        archive(capacity);
        archive(size);
        archive(free_slots);
        archive(alives);
        
        plants.load(archive);
        coords.load(archive);
        ages.load(archive);
    }

// @codegen:end database_generation
};

}
