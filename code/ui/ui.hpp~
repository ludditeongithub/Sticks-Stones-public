struct StatusBar {
  const int max;
  int current;
  const SDL_Rect *fullBar;
  const SDL_Rect *emptyBar;
  const SCoord position; // left corner

	StatusBar(int max, SCoord position, const SDL_Rect* fullBar, const SDL_Rect* emptyBar) : max(max), fullBar(fullBar), emptyBar(emptyBar), position(position) {
	  
  }

  void render(SDL_Rect viewport) {
	  //TODO: error
    float portion = current / max;
    int fullLength = fullBar->w;
    int h = fullBar->h;
    int filledLength = portion * fullLength;
    int unfilledLength = fullLength - filledLength;
    SDL_Rect unfilledClip = { emptyBar->x, emptyBar->y,unfilledLength, h};
    SDL_Rect filledClip = {fullBar->x, fullBar->y,filledLength, h};
    gSpriteSheetTexture.render(position.x, position.y, &unfilledClip, &viewport);
    gSpriteSheetTexture.render(position.x + unfilledLength, position.y, &filledClip, &viewport);
  }
};


