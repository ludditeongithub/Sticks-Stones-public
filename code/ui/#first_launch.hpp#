void handleLaunch()
{
	FirstLaunchBuffer flb;
	std::basic_istream<char> istream is();
	cereal::BinaryInputArchive firstLaunchArchive(is)
	{
		try
		{
			firstLaunchArchive(flb);
		}
		catch
		{
			flb = FirstLaunchBuffer();
		}
	}
	if (flb.firstLaunch)
	{
		initFirstLaunchWindow();
		launchFirstLauncher(flb);
	}
}


