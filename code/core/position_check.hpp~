template <typename T>
bool is_in_path(const T &map, Coord start, Coord end, const uint32_t obstacle)
{
	uint32_t dx = unsigned_abs_diff(end.x, start.x);
	uint32_t dy = unsigned_abs_diff(end.y, start.y);
	uint32_t sx = start.x < end.x ? 1 : -1;
	uint32_t sy = start.y < end.y ? 1 : -1;
	uint32_t err = dx - dy;

	uint32_t x = start.x;
	uint32_t y = start.y;

	while (true)
	{
		// Check if the current tile matches the condition (e.g., is blocked)
		if (map[y][x] == obstacle)
		{
			return true; // Blocked tile found in the path
		}

		if (x == end.x && y == end.y)
		{
			break; // Reached the end tile
		}

		uint32_t e2 = 2 * err;
		if (e2 > -dy)
		{
			err -= dy;
			x += sx;
		}
		if (e2 < dx)
		{
			err += dx;
			y += sy;
		}
	}

	return false; // No blocked tiles in the path
}

bool coords_in_path(Coord start, Coord end, Coord between)
{
	uint32_t dx = std::unsigned_abs_diff(end.x , start.x);
	uint32_t dy = std::unsigned_abs_diff(end.y , start.y);
	uint32_t sx = start.x < end.x ? 1 : -1;
	uint32_t sy = start.y < end.y ? 1 : -1;
	uint32_t err = dx - dy;

	uint32_t x = start.x;
	uint32_t y = start.y;

	while (true)
	{
		if (y == between.y && x == between.x)
		{
			return true; // Blocked tile found in the path
		}

		if (x == end.x && y == end.y)
		{
			break; // Reached the end tile
		}

		uint32_t e2 = 2 * err;
		if (e2 > -dy)
		{
			err -= dy;
			x += sx;
		}
		if (e2 < dx)
		{
			err += dx;
			y += sy;
		}
	}

	return false; // No blocked tiles in the path
}

/* HELPER FUNCTIONS */
bool adj_check(const std::vector<std::vector<uint32_t>>& map, uint32_t y, uint32_t x, uint32_t check, uint32_t range)
{
	uint32_t rows = map.size();	  // height
	uint32_t cols = map[0].size(); // width

	for (uint32_t r = -range; r <= range; r++)
	{
		for (uint32_t c = -range; c <= range; c++)
		{
			if (r == 0 && c == 0)
				continue;

			uint32_t nx = x + c;
			uint32_t ny = y + r;

			if (abs((uint32_t)r) + abs((uint32_t)c) <= range && nx >= 0 && nx < cols && ny >= 0 &&
			    ny < rows)
			{
				if (map[ny][nx] == check)
				{
					return true;
				}
			}
		}
	}
	return false;
}

template <typename L, typename M, typename T>
bool adj_check(L &reference_map, M &map, uint32_t y, uint32_t x, T check, uint32_t range)
{
	for (uint32_t r = -range; r <= range; r++)
	{
		for (uint32_t c = -range; c <= range; c++)
		{
			if (r == 0 && c == 0)
				continue;

			uint32_t nx = x + c;
			uint32_t ny = y + r;
			if (reference_map.find({ny, nx}) != reference_map.end())
			{
				uint32_t index = reference_map.at({ny, nx});
				auto item = map[index];

				if (abs(r) + abs(c) <= range && nx >= 0)
				{
					if (item == check)
					{
						return true;
					}
				}
			}
		}
	}
	return false;
}

bool adj_check_object(uint32_t y_index, uint32_t x_index, bool y_animal, bool x_animal, std::vector<Coord>& animal_coords, std::vector<Coord>& current_coords)
{
	Coord fc, sc;
	if (y_animal)
		fc = animal_coords[y_index];
	else
		fc = current_coords[y_index];
	if (x_animal)
		sc = animal_coords[x_index];
	else
		sc = current_coords[y_index];
	
	if ((unsigned_abs_diff((uint32_t)fc.y , sc.y) == 1 || unsigned_abs_diff((uint32_t)fc.y , sc.y) == 0) &&
	    (unsigned_abs_diff((uint32_t)fc.x , sc.x) == 0 || unsigned_abs_diff((uint32_t)fc.x , sc.x) == 1))
		return true;
	return false;
}

