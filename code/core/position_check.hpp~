	{
		for (uint32_t c = -range; c <= range; c++)
		{
			if (r == 0 && c == 0)
				continue; // Skip the center tile

			uint32_t nx = x + c;
			uint32_t ny = y + r;
			if (reference_map.find({ny, nx}) != reference_map.end())
			{
				uint32_t index = reference_map.at({ny, nx});
				auto item = map[index];

				if (unsigned_abs_diff(r) + unsigned_abs_diff(c) <= range && nx >= 0)
				{
