struct TileBlock()
{
	Coord start_tile;
	uuint32_t8_t block_size;
	Direction direction;
}

TileBlock
get_nearest_adjacent_empty_tile_block(uint32_t start_index, uuint32_t8_t block_size)
{
	std::queue<uint32_t> q;
	std::unordered_set<uint32_t> visited;
	Direction direction;

	q.push(start_index);
	visited.insert(start_index);

	while (!q.empty())
	{
		uint32_t current = q.front();
		q.pop();

		auto [above, right, below, left] = adjacent_tiles_indices[current];
		std::array<uint32_t, 4> neighbors = {above, right, below, left};

		for (uint32_t neighbor : neighbors)
		{
			if (neighbor < 0 || visited.count(neighbor))
				continue;

			if (check_empty_tile(current, neighbor))
			{
				// Found an empty tile, now check for a block of adjacent empty
				// tiles
				uint32_t count = 1; // Start with the current empty tile
				// Check horizontal and vertical directions for contiguous empty
				// tiles

				// Check to the right
				uint32_t temp = neighbor;
				while (check_empty_tile(current, temp) && visited.count(temp) == 0)
				{
					count++;
					visited.insert(temp);
					temp = right; // move right
					direction = west;
				}

				// Check to the left
				temp = neighbor;
				while (check_empty_tile(current, temp) && visited.count(temp) == 0)
				{
					count++;
					visited.insert(temp);
					temp = left; // Move left
					direction = east;
				}

				// Check above
				temp = neighbor;
				while (check_empty_tile(current, temp) && visited.count(temp) == 0)
				{
					count++;
					visited.insert(temp);
					temp = above; // Move above
					direction = north;
				}

				// Check below
				temp = neighbor;
				while (check_empty_tile(current, temp) && visited.count(temp) == 0)
				{
					count++;
					visited.insert(temp);
					temp = below; // Move below
					direction = south;
				}

				// If count meets or exceeds required count of adjacent empty tiles
				if (count >= block_size)
				{
					return {tile_coords[neighbor], block_size, direction};
				}
			}
			visited.insert(neighbor);
			q.push(neighbor);
		}
	}
	return {-1, -1}; // No empty tile block found
}

