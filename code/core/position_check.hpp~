struct Node
{
	uint32_t index;
	uuint32_t8_t move_cost; // The cost of moving to this node
	uuint32_t8_t f_cost;	  // f_cost = g_cost + heuristic
	Node *parent;	  // Parent node for path reconstruction

	Node(uint32_t index, uuint32_t8_t move_cost, uuint32_t8_t f_cost, Node *parent = nullptr)
	    : index(index), move_cost(move_cost), f_cost(f_cost), parent(parent)
	{
	}

	bool operator>(const Node &other) const { return f_cost > other.f_cost; }
};

uuint32_t16_t man_dist(uint32_t x1, uint32_t y1, uint32_t x2, uint32_t y2) { return std::unsigned_abs_diff(x1 , x2) + std::unsigned_abs_diff(y1 , y2); }

uuint32_t16_t man_dist(Coord x, Coord y)
{
	return std::unsigned_abs_diff(x.y , y.y) + std::unsigned_abs_diff(x.x , y.x);
}

inline bool within(Coord subject, Coord border_top_left_corner, Coord border_dimensions)
{
	if (subject.x <= border_top_left_corner.x + border_dimensions.x && subject.y <= border_top_left_corner.y + border_dimensions.y && subject.x > border_top_left_corner.x && subject.y > border_top_left_corner.y) return true;
	return false;
}	

