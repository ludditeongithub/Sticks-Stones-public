#pragma once
#include <cassert>
#include "memory.hpp"

template <typename T>
struct Array {
    Pool<T>& pool;

    uint32_t* activeIndices;
    uint32_t  activeCount = 0;  
    uint32_t  capacity;

    T& operator[](uint32_t i) {
        return pool[activeIndices[i]];
    }

    uint32_t size() const { return activeCount; }  

    void push(uint32_t poolIndex) {
        assert(activeCount < capacity);
        activeIndices[activeCount++] = poolIndex;
    }

    void remove(uint32_t i) { activeIndices[i] = activeIndices[--activeCount]; }

  Array(uint32_t capacity) {
      this->capacity = capacity;
      pool = Pool<T>(capacity);
  }
  
    ~Array() {
      ~pool();
      }  
};


template <typename T>
struct PriorityQueue {
  Arena<T> arena; 
  int current;
  int nx;

  inline T top() {
    return arena[current];
  };
  
  inline void pop() {
    if (current > arena.capacity) std::cerr << "Priority Queue is out of memory!" << std::endl;
    current++;
  };

  inline T next() {
    return arena[nx++];
  };

  inline void resetNext() {
    nx = current;
  };
};