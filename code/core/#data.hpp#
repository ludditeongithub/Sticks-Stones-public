#pragma once
#include <cmath>
#include <cstdint>

struct Coord
{
	uint32_t x;
	uint32_t y;

	Coord operator*=(uint32_t s)
	{
		return Coord(this->x * s, this->y * s);
	}		
};

struct SCoord
{
	int x;
	int y;

	SCoord operator*=(uint32_t s)
	{
		return SCoord(this->x * s, this->y * s);
	}
};

bool adjacentCoords(Coord first, Coord second)
{
	return (std::abs(static_cast<int>(first.x - second.x)) <= 1 &&
		std::abs(static_cast<int>(first.y - second.y)) <= 1);
}

