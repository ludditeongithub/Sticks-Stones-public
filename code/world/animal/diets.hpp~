#ifndef DIETS_HPP
#define DIETS_HPP

#include <enums>
#include <bitset>

using AnimalSet = std::bitset<static_cast<size_t>(Animal::MAX)>;

constexpr AnimalSet makeGrassEaters() {
    AnimalSet s;
    s.set(static_cast<size_t>(Animal::Cow));
    s.set(static_cast<size_t>(Animal::Sheep));
    s.set(static_cast<size_t>(Animal::Goat));
    s.set(static_cast<size_t>(Animal::Rabbit));
    s.set(static_cast<size_t>(Animal::Antelope));
    s.set(static_cast<size_t>(Animal::Deer));
    s.set(static_cast<size_t>(Animal::Caribou));
    return s;
}

constexpr AnimalSet grassEaters = makeGrassEaters();

