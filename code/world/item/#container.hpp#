enum class ContainerFullTags : uint8_t
{
	NONE = 0,
	Empty = 1 << 1,
	HandsOnly = 1 << 2,
	InventoryContainersFull = 1 << 3,
	NextContainer = 1 << 4, // if there is a next container
	ItemOverflow = 1 << 5,
	VariantItemOverflow = 1 << 6,
	ToolOverflow = 1 << 7
};

