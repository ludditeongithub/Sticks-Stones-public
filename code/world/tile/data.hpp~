uint16_t getIndex(int x, int y) { return x + y * CHUNK_SIZE; };
uint16_t manhattanDistance(int i1, int i2) {
  int x1 = i1 % CHUNK_SIZE;
  int x2 = i2 % CHUNK_SIZE;
  int y1 = i1 / CHUNK_SIZE;
  int y2 = i2 % CHUNK_SIZE;
  return abs(x1 - x2) + abs(y1 - y2);
};
  
uint16_t heuristic(int i1, int i2) {
  return manhattanDistance(i1, i2) * AVERAGE_MOVE_COST;
};
  
