#include <SDL2/SDL_rect.h>
#include <string>
#include <variant>

#include <data/types/animal.hpp>
#include <data/types/item.hpp>
#include <data/types/plant.hpp>
#include <data/types/unit.hpp>

#include "ui.hpp"

struct TextBox : UIElement
{
	std::string text;

	void render(SDL_Rect viewport) { UIElement::render(viewport); }
};

struct ItemTextBox : TextBox
{
	Item item;
};

struct AnimalTextBox : TextBox
{
	Animal animal;
};

struct PlantTextBox : TextBox
{
	Plant plant;
};

struct RoleTextBox : TextBox
{
	Role role;
};

using TextBoxVariant = std::variant<ItemTextBox, RoleTextBox, AnimalTextBox, PlantTextBox>;
