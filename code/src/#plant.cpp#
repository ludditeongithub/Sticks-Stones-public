    }
}

// event trigger, triggers after waterFall is set
void PlantDatabase::attemptPlantGrowth(int plant, int time, int biomeIndex) {
  if (collectedWater[plant] += waterFall[biomeIndex] < mandatoryWater[static_cast<int>(plant)]) {
    yieldMisses[plant]++;
  }
  growthAmt[plant] += time;
}

void PlantDatabase::excreteSeed(int animalIndex, Plant plant) {
  std::pair<int,int> coords = animalCoords[animalIndex];
  addCrop(plant, findNearestAdjacentEmptyTile(coords));
}

void PlantDatabase::plant(int unitIndex, Plant plant) {
 std::pair<int,int> coords = currentCoords[animalIndex];
  addCrop(plant, findNearestAdjacentEmptyTile(coords));
}

//TODO: complete and render
void PlantDatabase::killTree(int plantIndex) {
    switch (tilePlant[plantIndex]) {
        case Plant::PioneerTree:
            blockSize = 1;
            break;
        case Plant::DeciduousTree:
            blockSize = 2;
            break;
        case Plant::EvergreenTree:
            blockSize = 3;
            break;
        case Plant::RainforestTree:
            blockSize = 4;
            break;
        default:
            return;
    }
    TileBlock tb = findNearestAdjacentEmptyTileBlock(plantIndex, blockSize);
    std::tuple<int,int,int,int> adjacentTiles = adjacentTilesIndices[plantIndex];
    tilePlant[plantIndex] = Plant::Stump;
    int newTileIndex;
    for (int i = 1; i < blockSize; i++) {
        if (tb.direction == Direction::North) {
            newTileIndex = std::get<0>(adjacentTiles);
            adjacentTiles = adjacentTilesIndices;
        }
        if (tb.direction == Direction::South) {
            return std::get<2>(adjacentTiles);
        }
        if (tb.direction == Direction::West) {
            return std::get<4>(adjacentTiles);
        }
        if (tb.direction == Direction::East) {
            return std::get<1>(adjacentTiles);
        }
    }
}

void PlantDatabase::killPlant(int plantIndex) {
        Plant plant = tilePlant[tileIndex];
        PlantType type = plants[(int)plant].plantType;

        tileObject[tileObjectIndex] = Plant::None;
        switch (plantType) {
            case Tree:
            case FruitTree:
                treeDeath(plantIndex);
        }
}

// crops update loop
void PlantDatabase::updateCrops() {
    for (int i = 0; i < cropList.size(); i++) {
        //get data for croptype
        Crops c = cropList[i];
        float fga = fullyGrownAmt[c];
        float ngmin = noGrowthMin[c];
        float ngmax = noGrowthMax[c];
        float omin = optimalMin[c];
        float omax = optimalMax[c];
        float dmin = deathMin[c];
        float dmax = deathMax[c];
        float wr = waterRequired[c];
        float wd = waterDeath[c];
        float ha = harvestAmt[c];
        float rs = requiresScythe[c];
        /* determine water status:
         * all 3 states determined by one waterRequired variable. Plant can collect x2 of waterRequired. If <, yieldMissed, too dry. If x4, waterlogged, yieldMissed. */
        float wcomp = 1.0;
        //1. collect water from ground
        //check for waterlog
        if (collectedWater[i] < wr) {
            yieldMisses[i]++;
            wcomp = collectedWater[i] / wr;
        } else {
            lastFullyWatered[i] = date;
        }
        //check if plant death
        if (temp < dmin || temp > dmax || date - lastFullyWatered[i] > wd) {
                cropList[i] = EMPTY;
                continue;
        }
            if (fullyGrown[i]) continue;
        //growthrate = sunlight * watercomponent *  soilquality * temperature
        if (sunlight == 0.0) {
            growthAmt[i] = 0.0;
        } else {
            //get temp component
        float tcomp;
        if (temp > omin && temp < omax) {
            tcomp = 1.0;
        } else if (temp < omin) {
          if (temp < ngmin) {
                tcomp = 0.0;
            } else {
                tcomp = (20.0 - (cmath::abs(temp - omin))) * 0.05;
            }
        } else {
            if (temp > ngmax){
                tcomp = 0.0;
            } else {
                 tcomp = (20.0 - (cmath::abs(temp - omax))) * 0.05;
            }
        }
        //add growthrate
        growthAmt[i] += sunlight * tcomp * wcomp;
        if (growthAmt[i] >= fga)  fullyGrown[i] = true;
        } //if sunlight == 0
    }
}


// crops update loop
void PlantDatabase::updateRegrowthCrops() {
    for (int i = 0; i < regrowthCropList.size(); i++) {
        //get data for croptype
        RegrowthCrops c = rCropList[i];
        float la = lifespanAmt[c];
        float ngmin = rnoGrowthMin[c];
        float ngmax = rnoGrowthMax[c];
        float omin = roptimalMin[c];
        float omax = roptimalMax[c];
        float dmin = rdeathMin[c];
        float dmax = rdeathMax[c];
        float wr = rwaterRequired[c];
        float wd = rwaterDeath[c];
        float sha = rstartingHarvestAmt[c];
        float eha = rendingHarvestAmt[c];
        float rs = regrowthStart[c];
        float r = regrowthPeriod[c];
        /* determine water status:
         * all 3 states determined by one waterRequired variable. Plant can collect x2 of waterRequired. If <, yieldMissed, too dry. If x4, waterlogged, yieldMissed. */
        float wcomp = 1.0;
        //1. collect water from ground
        //check for waterlog
        if (rCollectedWater[i] < wr) {
            rYieldMisses[i]++;
            wcomp = rCollectedWater[i] / wr;
        } else {
            regrowthLastFullyWatered[i] = date;
        }
        //check if plant death
        if (temp < dmin || temp > dmax || date - rLastFullyWatered[i] > wd) {
                regrowthCropList[i] = EMPTY;
                continue;
        }
        //growthrate = sunlight * watercomponent *  soilquality * temperature
        if (sunlight == 0.0) {
            regrowthGrowthAmt[i] = 0.0;
        } else {
            //get temp component
        float tcomp;
        if (temp > omin && temp < omax) {
            tcomp = 1.0;
        } else if (temp < omin) {
          if (temp < ngmin) {
                tcomp = 0.0;
            } else {
                tcomp = (20.0 - (cmath::abs(temp - omin))) * 0.05;
            }
        } else {
            if (temp > ngmax){
                tcomp = 0.0;
            } else {
                 tcomp = (20.0 - (cmath::abs(temp - omax))) * 0.05;
            }
        }
        //add growthrate
        regrowthGrowthAmt[i] += sunlight * tcomp * wcomp;
        if (regrowthGrowthAmt[i] >= la) {
            regrowthCropList[i] = EMPTY;
            continue;
        }
        //add regrowth
        if (regrowthGrowthAmt[i] < rs && !regrowthHarvestable[i]) {
            regrowthAmt[i] += sunlight * tcomp * wcomp;
        }
        if (regrowthAmt[i] > rs) {
            regrowthHarvestable[i] = true;
        }
        } //if sunlight == 0
    }
}
