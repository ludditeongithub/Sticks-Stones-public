#include <animal/breeding_manager.hpp>

void BreedingManager::layEgg(Animal animal, int animalIndex) {
	std::pair<int, int> animalCoord = coords[animalIndex];
	int index = tileIndices(coords);
	//TODO: make variable hatching times for each egg
    animalMatingStatus[animalIndex] == MatingStatus::Pregnant ? bool fertilized = true : bool fertilized = false;
	addEgg(animalCoord, index, animal, fertilized);

}

void BreedingManager::hatchEgg(Animal animal, int coordIndex) {
	spawnAnimal(animal, coordIndex);
	tileObject[index] = Scavengeable::NONE;
}

std::pair<int,int> BreedingManager::findBreedingPartner(int x, int y, int i, Animal animal) {
	std::pair<int,int> ne = findNearestObject(animal, x, y);
	return -1; //not found
}

